uint32_t fiestel (uint32_t r,uint32_t k)
{
return r^k;
}
void initial_permutation(unsigned char in[8],unsigned char out[8])
{
int i;
for(i=0;i<8;i++)
out[i]=0;
for(i=0;i<64;i++)
{
int pos = IP[i];
int byte = pos/8;
int bit = pos%8;
if(in [byte] & (1<<(7-bit)))
out[i/8] |= (1<<(7-i%8));
}
}
